# Kopier til .env. Installasjonsskriptet lager denne filen for deg, med tilfeldige passord.
POSTGRES_PASSWORD=
SECRET_KEY=
# Oppsettskoden gir deg tilgang til oppsettveiviseren første gang panelet åpnes. Velg passordet der.
SETUP_CODE=
# Bare hvis du vil hoppe over veiviseren: passord for innlogging.
#PANEL_PASSWORD=

# Valgfritt: alt under kan også settes i panelet (Innstillinger).
PANEL_DOMAIN=
ACME_EMAIL=
HOST_ADDRESS=
#PANEL_PORT=8100
#HTTP_PORT=80
#HTTPS_PORT=443
#OUP_DATA=oup-data          # navn på volum, eller en mappe (/srv/oup eller ./data) hvis du vil ha filene i en vanlig mappe
#PG_SHARED_BUFFERS=512MB    # 1GB eller mer på maskiner med 16 GB minne eller mer

# Valgfritt: Cloudflare Tunnel i stedet for åpne porter (anbefalt). Lag en tunnel i Cloudflare Zero Trust
# (Networks → Tunnels), kopier tokenet hit, og legg til et vertsnavn (*.firma.no) som peker til http://caddy:80.
# Sett også INSTANCE_DOMAIN_HTTPS=cloudflare (eller velg «Cloudflare» i panelet under Innstillinger → Domener).
# Start så med: docker compose up -d
#COMPOSE_PROFILES=tunnel
#CLOUDFLARE_TUNNEL_TOKEN=
#INSTANCE_DOMAIN_HTTPS=cloudflare
